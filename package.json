{
  "name": "ternak",
  "version": "1.0.0",
  "description": "Cattle Farm Manager - Ranch OS",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:gen": "drizzle-kit generate",
    "db:mig": "tsx scripts/migrate.ts",
    "db:drop": "tsx scripts/drop-tables.ts",
    "db:migrate-fresh": "tsx scripts/drop-tables.ts && npm run db:gen && npm run db:mig",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "npm run db:migrate-fresh && npm run db:seed",
    "create-admin": "tsx scripts/create-admin.ts",
    "init": "npm run db:migrate-fresh && npm run db:seed",
    "db:migrate": "npm run db:gen && npm run db:mig",
    "db:reset": "npm run db:migrate-fresh && npm run db:seed"
